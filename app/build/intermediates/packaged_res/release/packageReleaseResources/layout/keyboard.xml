<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:splitMotionEvents="false">

    <LinearLayout
        android:id="@+id/preview_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/preview_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical|start"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:ellipsize="none"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeStepGranularity="2sp"
            android:maxLines="1"
            android:text="　"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/main_keyboard_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary_color">

    <!-- 漢字候補 -->
        <LinearLayout
            android:id="@+id/candidate_container"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/kanji_1"
                style="@style/KanjiButton"
                android:layout_width="0dp"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/kanji_2"
                style="@style/KanjiButton"
                android:layout_width="0dp"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/kanji_3"
                style="@style/KanjiButton"
                android:layout_width="0dp"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/kanji_4"
                style="@style/KanjiButton"
                android:layout_width="0dp"
                android:layout_weight="1"/>
        </LinearLayout>

    <!-- キーボード本体 -->
        <GridLayout
            android:id="@+id/keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="12"
            android:orientation="horizontal">

            <!-- 数字列 -->
            <Button android:id="@+id/ABC" style="@style/KeyboardButton" android:text="ABC"/>
            <Button android:id="@+id/key_1" style="@style/KeyboardButton" android:text="１"/>
            <Button android:id="@+id/key_2" style="@style/KeyboardButton" android:text="２"/>
            <Button android:id="@+id/key_3" style="@style/KeyboardButton" android:text="３"/>
            <Button android:id="@+id/key_4" style="@style/KeyboardButton" android:text="４"/>
            <Button android:id="@+id/key_5" style="@style/KeyboardButton" android:text="５"/>
            <Button android:id="@+id/key_6" style="@style/KeyboardButton" android:text="６"/>
            <Button android:id="@+id/key_7" style="@style/KeyboardButton" android:text="７"/>
            <Button android:id="@+id/key_8" style="@style/KeyboardButton" android:text="８"/>
            <Button android:id="@+id/key_9" style="@style/KeyboardButton" android:text="９"/>
            <Button android:id="@+id/key_0" style="@style/KeyboardButton" android:text="０"/>
            <Button android:id="@+id/del" style="@style/KeyboardButton" android:text="\u232B"/>

            <!-- あ段 -->
            <Button android:id="@+id/kakko" style="@style/KeyboardButton" android:text="「」"/>
            <Button android:id="@+id/wa" style="@style/KeyboardButton" android:text="わ"/>
            <Button android:id="@+id/ra" style="@style/KeyboardButton" android:text="ら"/>
            <Button android:id="@+id/ya" style="@style/KeyboardButton" android:text="や"/>
            <Button android:id="@+id/ma" style="@style/KeyboardButton" android:text="ま"/>
            <Button android:id="@+id/ha" style="@style/KeyboardButton" android:text="は"/>
            <Button android:id="@+id/na" style="@style/KeyboardButton" android:text="な"/>
            <Button android:id="@+id/ta" style="@style/KeyboardButton" android:text="た"/>
            <Button android:id="@+id/sa" style="@style/KeyboardButton" android:text="さ"/>
            <Button android:id="@+id/ka" style="@style/KeyboardButton" android:text="か"/>
            <Button android:id="@+id/a" style="@style/KeyboardButton" android:text="あ"/>
            <Button android:id="@+id/tra" style="@style/KeyboardButton" android:text="\u21c4"/>

            <!-- い段 -->
            <Button android:id="@+id/qes" style="@style/KeyboardButton" android:text="？"/>
            <Button android:id="@+id/wo" style="@style/KeyboardButton" android:text="を"/>
            <Button android:id="@+id/ri" style="@style/KeyboardButton" android:text="り"/>
            <Button android:id="@+id/blank_1" style="@style/KeyboardButton" android:text=""/>
            <Button android:id="@+id/mi" style="@style/KeyboardButton" android:text="み"/>
            <Button android:id="@+id/hi" style="@style/KeyboardButton" android:text="ひ"/>
            <Button android:id="@+id/ni" style="@style/KeyboardButton" android:text="に"/>
            <Button android:id="@+id/ti" style="@style/KeyboardButton" android:text="ち"/>
            <Button android:id="@+id/si" style="@style/KeyboardButton" android:text="し"/>
            <Button android:id="@+id/ki" style="@style/KeyboardButton" android:text="き"/>
            <Button android:id="@+id/i" style="@style/KeyboardButton" android:text="い"/>
            <Button android:id="@+id/enter" style="@style/KeyboardButton" android:text="\u23CE" android:textStyle="bold" android:layout_row="2" android:layout_column="11" android:layout_rowSpan="2" android:layout_height="114dp"/>

            <!-- う段 -->
            <Button android:id="@+id/eqs" style="@style/KeyboardButton" android:text="！"/>
            <Button android:id="@+id/nn" style="@style/KeyboardButton" android:text="ん"/>
            <Button android:id="@+id/ru" style="@style/KeyboardButton" android:text="る"/>
            <Button android:id="@+id/yu" style="@style/KeyboardButton" android:text="ゆ"/>
            <Button android:id="@+id/mu" style="@style/KeyboardButton" android:text="む"/>
            <Button android:id="@+id/hu" style="@style/KeyboardButton" android:text="ふ"/>
            <Button android:id="@+id/nu" style="@style/KeyboardButton" android:text="ぬ"/>
            <Button android:id="@+id/tu" style="@style/KeyboardButton" android:text="つ"/>
            <Button android:id="@+id/su" style="@style/KeyboardButton" android:text="す"/>
            <Button android:id="@+id/ku" style="@style/KeyboardButton" android:text="く"/>
            <Button android:id="@+id/u" style="@style/KeyboardButton" android:text="う" />

            <!-- え段 -->
            <Button android:id="@+id/setting2" style="@style/KeyboardButton" android:text=""/>
            <Button android:id="@+id/long_bar" style="@style/KeyboardButton" android:text="ー"/>
            <Button android:id="@+id/re" style="@style/KeyboardButton" android:text="れ"/>
            <Button android:id="@+id/blank_3" style="@style/KeyboardButton" android:text=""/>
            <Button android:id="@+id/me" style="@style/KeyboardButton" android:text="め"/>
            <Button android:id="@+id/he" style="@style/KeyboardButton" android:text="へ"/>
            <Button android:id="@+id/ne" style="@style/KeyboardButton" android:text="ね"/>
            <Button android:id="@+id/te" style="@style/KeyboardButton" android:text="て"/>
            <Button android:id="@+id/se" style="@style/KeyboardButton" android:text="せ"/>
            <Button android:id="@+id/ke" style="@style/KeyboardButton" android:text="け"/>
            <Button android:id="@+id/e" style="@style/KeyboardButton" android:text="え"/>
            <Button android:id="@+id/dot" style="@style/KeyboardButton" android:text="、。"/>

            <!-- お段 -->
            <Button android:id="@+id/setting" style="@style/KeyboardButton" android:text="\u2699"/>
            <Button android:id="@+id/minus" style="@style/KeyboardButton" android:text="゛゜小"/>
            <Button android:id="@+id/ro" style="@style/KeyboardButton" android:text="ろ"/>
            <Button android:id="@+id/yo" style="@style/KeyboardButton" android:text="よ"/>
            <Button android:id="@+id/mo" style="@style/KeyboardButton" android:text="も"/>
            <Button android:id="@+id/ho" style="@style/KeyboardButton" android:text="ほ"/>
            <Button android:id="@+id/no" style="@style/KeyboardButton" android:text="の"/>
            <Button android:id="@+id/to" style="@style/KeyboardButton" android:text="と"/>
            <Button android:id="@+id/so" style="@style/KeyboardButton" android:text="そ"/>
            <Button android:id="@+id/ko" style="@style/KeyboardButton" android:text="こ"/>
            <Button android:id="@+id/o" style="@style/KeyboardButton" android:text="お"/>
            <Button android:id="@+id/sp" style="@style/KeyboardButton" android:text="\u2423"/>
        </GridLayout>
    </LinearLayout>
</LinearLayout>