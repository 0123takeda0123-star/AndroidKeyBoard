<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.FiftyOnKeyboardIME">
        <activity
            android:name="jp.takeda0123.fiftyonkeyboardime.MainActivity"
            android:exported="true"

            android:theme="@style/Theme.FiftyOnKeyboardIME">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="jp.takeda0123.fiftyonkeyboardime.SimpleIME"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="false"
            android:theme="@style/Theme.FiftyOnKeyboardIME.Ime"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>



    </application>

</manifest>